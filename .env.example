# Copy this file to .env and fill in your values:  cp .env.example .env

# --- Kafka (running on EC2) ---
# Use the EC2 PUBLIC IPv4 address, the same one set in advertised.listeners
KAFKA_BOOTSTRAP_SERVERS=<EC2_PUBLIC_IP>:9092
KAFKA_TOPIC=ev-telemetry
KAFKA_GROUP_ID=ev-telemetry-s3-sink

# --- Producer ---
NUM_VEHICLES=20
MIN_INTERVAL_SECONDS=1.0
MAX_INTERVAL_SECONDS=2.0

# --- Consumer / S3 ---
S3_BUCKET=<your-unique-bucket-name>
S3_PREFIX=raw/ev_telemetry
AWS_REGION=us-east-2
# Optional: named profile from ~/.aws/credentials (leave empty for "default")
# AWS_PROFILE=

# Records per S3 file. 1 = one JSON file per Kafka message.
# For real workloads use 100-1000 to avoid the "small files problem" in Athena.
BATCH_SIZE=1
# Flush whatever is buffered at least this often, even if BATCH_SIZE isn't reached
FLUSH_INTERVAL_SECONDS=10
